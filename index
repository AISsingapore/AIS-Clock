<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Canva Clock Widget</title>
    <style>
        /* This centers the clock perfectly on your Canva element */
        body {
            margin: 0;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            background-color: transparent; 
            overflow: hidden;
        }
    </style>
</head>
<body>

    <!-- Your LogWork Clock Code Below -->
    <script src="https://cdn.logwork.com/widget/clock.js"></script>
    <a href="https://logwork.com/clock-widget/" class="clock-time" data-style="default-numeral" data-size="250" data-timezone="Asia/Singapore">Current time in Singapore</a>

</body>
</html>
